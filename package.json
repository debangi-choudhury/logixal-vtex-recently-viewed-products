{
  "name": "recently-viewed-products",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint --ext .ts,.tsx react node",
    "test": "yarn --cwd node test && jest"
  },
  "devDependencies": {
    "@vtex/prettier-config": "^1.0.0",
    "eslint": "^7.32.0",
    "eslint-config-vtex": "^15.1.0",
    "eslint-config-vtex-react": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.5",
    "typescript": "4.9.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/react/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false,
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true
          }
        }
      ]
    }
  }
}
